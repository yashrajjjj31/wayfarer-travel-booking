PORT=3000
# On a hosted service, point DATA_DIR at a persistent disk.
DATA_DIR=./data
# SMS via Twilio. Copy this file to .env and add values from your Twilio console.
# The destination defaults to +91 7774004950.
NOTIFY_PHONE=+917774004950
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Protects GET /api/admin/bookings
ADMIN_KEY=
